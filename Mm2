
-- Active Counter GUI - Delta

local Players = game:GetService("Players")
local player = Players.LocalPlayer

if not player then
    warn("Player not found!")
    return
end

local playerGui = player:WaitForChild("PlayerGui")

-- Remove old GUI
local old = playerGui:FindFirstChild("ActiveCounterGUI")
if old then
    old:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "ActiveCounterGUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 999
gui.Parent = playerGui

-- Main box
local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(155, 42)
main.Position = UDim2.fromOffset(15, 15)
main.BackgroundColor3 = Color3.fromRGB(25, 27, 30)
main.BorderSizePixel = 0
main.Visible = true
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = main

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(55, 60, 65)
stroke.Thickness = 1
stroke.Parent = main

-- Green dot
local dot = Instance.new("Frame")
dot.Size = UDim2.fromOffset(9, 9)
dot.Position = UDim2.new(0, 13, 0.5, -4)
dot.BackgroundColor3 = Color3.fromRGB(50, 220, 100)
dot.BorderSizePixel = 0
dot.Parent = main

local dotCorner = Instance.new("UICorner")
dotCorner.CornerRadius = UDim.new(1, 0)
dotCorner.Parent = dot

-- Text
local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, -38, 1, 0)
label.Position = UDim2.fromOffset(31, 0)
label.BackgroundTransparency = 1
label.Text = "693 Active"
label.TextColor3 = Color3.fromRGB(235, 240, 235)
label.TextSize = 14
label.Font = Enum.Font.GothamMedium
label.TextXAlignment = Enum.TextXAlignment.Left
label.Parent = main

-- Random counter
task.spawn(function()
    while gui.Parent do
        label.Text = math.random(500, 1500) .. " Active"
        task.wait(4)
    end
end)

print("Active Counter GUI successfully loaded!")
