
-- Active Counter GUI | Delta

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("ActiveCounterGUI")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "ActiveCounterGUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.Parent = playerGui

-- Main frame
local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.fromOffset(165, 42)
main.Position = UDim2.fromOffset(15, 15)
main.BackgroundColor3 = Color3.fromRGB(25, 27, 30)
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
main.ClipsDescendants = false
main.Parent = gui

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)

local stroke = Instance.new("UIStroke", main)
stroke.Color = Color3.fromRGB(55, 60, 65)
stroke.Thickness = 1

-- Green dot
local dot = Instance.new("Frame")
dot.Size = UDim2.fromOffset(9, 9)
dot.Position = UDim2.new(0, 13, 0.5, -4)
dot.BackgroundColor3 = Color3.fromRGB(50, 220, 100)
dot.BorderSizePixel = 0
dot.Parent = main

Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

-- Active counter text
local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, -65, 1, 0)
label.Position = UDim2.fromOffset(31, 0)
label.BackgroundTransparency = 1
label.Text = "693 Active"
label.TextColor3 = Color3.fromRGB(235, 240, 235)
label.TextSize = 14
label.Font = Enum.Font.GothamMedium
label.TextXAlignment = Enum.TextXAlignment.Left
label.Parent = main

-- Menu button INSIDE main frame
local menu = Instance.new("TextButton")
menu.Size = UDim2.fromOffset(28, 28)
menu.Position = UDim2.new(1, -34, 0.5, -14)
menu.BackgroundColor3 = Color3.fromRGB(42, 45, 50)
menu.BorderSizePixel = 0
menu.Text = ""
menu.AutoButtonColor = true
menu.ZIndex = 5
menu.Parent = main

Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 6)

-- Three horizontal lines
for i = 1, 3 do
    local line = Instance.new("Frame")
    line.Size = UDim2.fromOffset(15, 2)
    line.Position = UDim2.new(0.5, -7, 0.5, -7 + ((i - 1) * 6))
    line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    line.BorderSizePixel = 0
    line.ZIndex = 6
    line.Parent = menu

    Instance.new("UICorner", line).CornerRadius = UDim.new(1, 0)
end

-- Expand panel
local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.Position = UDim2.fromOffset(10, 47)
panel.Size = UDim2.new(1, -20, 0, 25)
panel.BackgroundColor3 = Color3.fromRGB(38, 41, 46)
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = main

Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 7)

-- Menu toggle
local expanded = false

menu.Activated:Connect(function()
    expanded = not expanded

    if expanded then
        panel.Visible = true

        TweenService:Create(
            main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size = UDim2.fromOffset(165, 82)}
        ):Play()
    else
        local tween = TweenService:Create(
            main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size = UDim2.fromOffset(165, 42)}
        )

        tween:Play()

        tween.Completed:Connect(function()
            if not expanded then
                panel.Visible = false
            end
        end)
    end
end)

-- Simulated active counter
local currentCount = 693

task.spawn(function()
    while gui.Parent do
        task.wait(3)

        local change = math.random(1, 10)

        if math.random(1, 2) == 1 then
            change = -change
        end

        currentCount = math.clamp(currentCount + change, 500, 1500)
        label.Text = currentCount .. " Active"
    end
end)

print("Active Counter Loaded!")
