-- Expanded content
local expandedPanel = Instance.new("Frame")
expandedPanel.Name = "ExpandedPanel"
expandedPanel.Position = UDim2.fromOffset(10, 47)
expandedPanel.Size = UDim2.new(1, -20, 0, 25)
expandedPanel.BackgroundColor3 = Color3.fromRGB(34, 37, 41)
