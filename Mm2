-- Menu toggle
local opened = false

menu.Activated:Connect(function()
    opened = not opened

    if opened then
        panel.Visible = true

        TweenService:Create(
            main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quart),
            {Size = UDim2.new(0, 240, 0, 190)}
        ):Play()
    else
        local tween = TweenService:Create(
            main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quart),
            {Size = UDim2.new(0, 240, 0, 42)}
        )

        tween:Play()
        tween.Completed:Connect(function()
            if not opened then
                panel.Visible = false
            end
        end)
    end
end)

-- Simulated active counter
task.spawn(function()
    local count = 693

    while gui.Parent do
        task.wait(3)

        count = math.clamp(
            count + math.random(-10, 10),
            500,
            1500
        )

        counter.Text = count .. " Active"
    end
end)
