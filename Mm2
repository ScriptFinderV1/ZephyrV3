    local logo = Instance.new("TextLabel")
    logo.Size = UDim2.new(0, 35, 1, 0)
    logo.Position = UDim2.new(0, 7, 0, 0)
    logo.BackgroundTransparency = 1
    logo.Text = data.Logo
    logo.TextColor3 = data.Color
