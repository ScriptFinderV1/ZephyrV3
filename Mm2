menu.Font = Enum.Font.GothamBold
menu.ZIndex = 10
menu.Parent = gui

Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 7)

-- Expanded panel
local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(165, 35)
panel.Position = UDim2.fromOffset(15, 62)
panel.BackgroundColor3 = Color3.fromRGB(34, 37, 41)
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = gui

Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 9)

local panelText = Instance.new("TextLabel")
panelText.Size = UDim2.new(1, -16, 1, 0)
panelText.Position = UDim2.fromOffset(8, 0)
panelText.BackgroundTransparency = 1
panelText.Text = "Status: Simulated"
panelText.TextColor3 = Color3.fromRGB(210, 215, 220)
panelText.TextSize = 12
panelText.Font = Enum.Font.GothamMedium
panelText.TextXAlignment = Enum.TextXAlignment.Left
panelText.Parent = panel

-- Keep menu and panel following main while dragging
local function updatePosition()
    menu.Position = UDim2.new(
        main.Position.X.Scale,
        main.Position.X.Offset + main.AbsoluteSize.X - 35,
        main.Position.Y.Scale,
        main.Position.Y.Offset + 6
    )

    panel.Position = UDim2.new(
        main.Position.X.Scale,
        main.Position.X.Offset,
        main.Position.Y.Scale,
        main.Position.Y.Offset + 47
    )
end

main:GetPropertyChangedSignal("Position"):Connect(updatePosition)

-- Menu toggle
local expanded = false

menu.Activated:Connect(function()
    expanded = not expanded

    if expanded then
        panel.Visible = true
        TweenService:Create(
            panel,
            TweenInfo.new(0.25),
            {Size = UDim2.fromOffset(165, 35)}
        ):Play()
    else
        local tween = TweenService:Create(
            panel,
            TweenInfo.new(0.2),
            {Size = UDim2.fromOffset(165, 0)}
        )
        tween:Play()
        tween.Completed:Connect(function()
            if not expanded then
                panel.Visible = false
                panel.Size = UDim2.fromOffset(165, 35)
            end
        end)
    end
end)

-- Simulated counter
local currentCount = 693
label.Text = currentCount .. " Active"

task.spawn(function()
    while gui.Parent do
        task.wait(3)

        local change = math.random(1, 10)

        if math.random(1, 2) == 1 then
            change = -change
        end

        currentCount = math.clamp(currentCount + change, 500, 1500)
        label.Text = currentCount .. " Active"
    end
end)

updatePosition()

print("Active Counter Loaded!")
