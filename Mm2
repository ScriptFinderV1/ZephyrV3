local panelText = Instance.new("TextLabel")
panelText.Size = UDim2.new(1, -12, 1, 0)
panelText.Position = UDim2.fromOffset(8, 0)
panelText.BackgroundTransparency = 1
panelText.Text = "Status: Simulated"
panelText.TextColor3 = Color3.fromRGB(155, 165, 175)
panelText.TextSize = 11
panelText.Font = Enum.Font.Gotham
panelText.TextXAlignment = Enum.TextXAlignment.Left
panelText.Parent = expandedPanel

-- Expand / Collapse
local expanded = false

menuButton.MouseButton1Click:Connect(function()
    expanded = not expanded

    if expanded then
        expandedPanel.Visible = true

        TweenService:Create(
            main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size = UDim2.fromOffset(155, 82)}
        ):Play()
    else
        local tween = TweenService:Create(
            main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size = UDim2.fromOffset(155, 42)}
        )

        tween:Play()
        tween.Completed:Connect(function()
            if not expanded then
                expandedPanel.Visible = false
            end
        end)
    end
end)

-- Simulated active counter
local currentCount = 693

task.spawn(function()
    while gui.Parent do
        task.wait(3)

        local change = math.random(1, 10)

        if math.random(1, 2) == 1 then
            change = -change
        end

        currentCount = math.clamp(currentCount + change, 500, 1500)
        label.Text = currentCount .. " Active"
    end
end)

